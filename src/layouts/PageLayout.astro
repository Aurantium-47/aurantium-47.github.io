---
// Layout and canonical/Open Graph metadata adapted from Astro Nano (MIT).
import '../styles/global.css';
import { site } from '../site';
interface Props { title: string; description?: string; image?: string }
const { title, description = site.description, image = '/social-card.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['/', '首页'], ['/ai/', 'AI 成果'], ['/skills/', 'Skills'], ['/notes/', '随记'], ['/photos/', '照片'], ['/about/', '关于我']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.title ? title : `${title} · ${site.title}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#075b52" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:title" content={`${title} · Aurantium`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="橙子，回到首页"><img src="/favicon.svg" width="34" height="34" alt="" /><span>橙子<small>AURANTIUM</small></span></a>
      <nav aria-label="主导航">{nav.map(([url, label]) => <a href={url} aria-current={(url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(url)) ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <div><a href="/" class="footer-name">橙子 / Aurantium</a><p>好奇心的长期存放处。</p></div>
      <div class="footer-links"><a href="/resume/">项目简历</a><a href="/inspiration/">灵感与致谢</a><a href={site.github}>GitHub ↗</a><a href="/rss.xml">RSS ↗</a></div>
      <span class="mono copyright">© {new Date().getFullYear()} AURANTIUM</span>
    </footer>
  </body>
</html>
