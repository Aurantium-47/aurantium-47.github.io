---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { art } from '../lib/art';
import { site } from '../site';
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<PageLayout title={site.title}>
  <section class="hero shell">
    <div class="hero-copy"><p class="eyebrow"><span class="sun-dot"></span> 一个正在生长的个人小站</p><h1>把好奇心<br />过成<span class="orange">日常</span>。</h1><p class="hero-description">我是橙子，也叫 Aurantium。<br />这里放我的生活、想法、作品，<br />还有那些用 AI 试出来的新可能。</p><div class="hero-actions"><a class="button" href="/ai/">看看我的作品 <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">先认识一下我 →</a></div><p class="hero-signature mono">LIFE, IDEAS & A LITTLE BIT OF CHAOS.</p></div>
    <div class="hero-art"><span class="art-disc" aria-hidden="true"></span><div class="hero-frame"><Image src={art.julia} width={650} format="webp" alt="涌现图鉴：橙色与青色交织的 Julia 集艺术海报" loading="eager" fetchpriority="high" /><span class="frame-label mono">01 / INFINITE BOUNDARY</span></div><div class="mini-frame"><Image src={art.lorenz} width={280} format="webp" alt="Lorenz 系统的蝴蝶形轨迹" loading="eager" /></div><a class="art-caption" href="/lab/emergence/">这幅画会动。<span>进入我的数学小展馆 ↗</span></a><span class="vertical-caption mono" aria-hidden="true">A SMALL ATLAS OF CURIOSITY</span></div>
  </section>
  <div class="index-strip"><div class="shell"><span class="mono">IN MY CORNER OF THE INTERNET</span><a href="/notes/">写一点东西 ↗</a><a href="/photos/">留下生活的光 ↗</a><a href="/ai/">试试新的可能 ↗</a></div></div>
  <section class="section shell"><div class="section-heading"><div><p class="eyebrow">SELECTED EXPLORATIONS / 01</p><h2>我的 AI 成果</h2></div><a class="text-link" href="/ai/">全部探索 ↗</a></div><p class="section-intro">从“能不能做到”，到一个真的能打开、能使用的东西。<br />这里记录成果，也记录它是怎么做出来的。</p><div class="project-list">{projects.map((project, i) => <ProjectRow project={project} number={i + 1} />)}</div></section>
  <section class="life-section"><div class="shell life-grid"><div><p class="eyebrow">OFF THE WORKBENCH / 02</p><h2>也给生活<br />留一点位置。</h2><p>一些照片，一些日记，<br />一些暂时还没有结论的想法。</p><a class="text-link" href="/photos/">去相册逛逛 ↗</a></div><div class="note-panel"><div class="section-heading"><h3>最近的随记</h3><a href="/notes/" class="text-link">更多 ↗</a></div>{notes.map(note => <a class="note-link" href={`/notes/${note.id}/`}><div class="mono"><FormattedDate date={note.data.date} /><span>{note.data.kind}</span></div><h4>{note.data.title}</h4><p>{note.data.description}</p><span class="note-arrow" aria-hidden="true">↗</span></a>)}<p class="quiet-note">写长一点，写短一点，都可以。</p></div></div></section>
  <section class="closing shell"><p class="eyebrow">NICE TO MEET YOU</p><h2>你好，我是<span class="orange">橙子</span>。</h2><p>喜欢有用的工具，也喜欢没那么实用、但让人眼前一亮的作品。<br />这个小站会随我一起慢慢生长。</p><a class="text-link" href="/resume/">认识我的项目与经历 ↗</a></section>
</PageLayout>
