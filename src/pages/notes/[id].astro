---
// Static content routes adapted from Astro Nano; render() is Astro's current API.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
export async function getStaticPaths() {
  const posts = await getCollection('notes', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'notes'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<PageLayout title={post.data.title} description={post.data.description}><div class="article-heading shell"><a class="text-link" href="/notes/">← 所有随记</a><p class="eyebrow"><FormattedDate date={post.data.date} /> / {post.data.kind}</p><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p></div><article class="prose"><Content /></article></PageLayout>
